{
  "functions": {
    "api/shell.ts": { "includeFiles": "dist/index.html" }
  },
  "rewrites": [
    {
      "source": "/guide/:path+",
      "destination": "https://api.alraedlaw.com/guide/:path+"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|Discordbot|Pinterest|Googlebot|bingbot).*"
        }
      ],
      "destination": "/api/og"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
